# Copy to .env and adjust for your machine. Never commit .env.

# --- Profiles: where notes go and where recordings arrive -------------------
VAULT_PERSONAL=C:\Users\you\Obsidian\Personal
VAULT_WORK=C:\Users\you\Obsidian\Work
INBOX_PERSONAL=C:\Users\you\Inbox\Personal
INBOX_WORK=C:\Users\you\Obsidian\Work\Inbox

# --- Whisper (faster-whisper-xxl bundle) ------------------------------------
# Folder that contains faster-whisper-xxl.exe, ffmpeg.exe and postprocess.py.
WHISPER_DIR=C:\Tools\Faster-Whisper-XXL
# Or point to executables directly:
# WHISPER_EXE=C:\Tools\Faster-Whisper-XXL\faster-whisper-xxl.exe
# FFMPEG=C:\Tools\Faster-Whisper-XXL\ffmpeg.exe
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=ru
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=8
WHISPER_DIARIZE=pyannote_v3.1
WHISPER_MIN_SPEAKERS=2
WHISPER_MAX_SPEAKERS=3

# --- Summarization -----------------------------------------------------------
# local  = Ollama (private, weaker)
# cloud  = any OpenAI-compatible API (better summaries, text leaves the machine)
LLM_PROVIDER=local
LOCAL_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Behaviour ---------------------------------------------------------------
MIN_DURATION_SEC=60
POLL_SEC=20
